    <decisions>
        <description>Used as a decision to check the disposition value.</description>
        <name>Decision_Lead_Call_Disposition</name>
        <label>Decision - Lead Call Disposition</label>
        <locationX>710</locationX>
        <locationY>1727</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Working_Not_Contacted</name>
            <conditionLogic>(1 OR 2 OR 3) AND (4 OR 5)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SalesLoft1__Call_Disposition__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Connected - Gatekeeper - No contact with prospect</stringValue>
