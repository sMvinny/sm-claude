    <description>Post flow to update related lead or contact data</description>
    <formulas>
        <description>Used to set dead date</description>
        <name>DeadDate</name>
        <dataType>Date</dataType>
        <expression>IF(
AND(
{!varRating} = &quot;Dead Lead&quot;,
ISBLANK({!varDeadDate})),
{!$Flow.CurrentDate},
{!varDeadDate}
)</expression>
    </formulas>
    <formulas>
        <description>Used to store the Lead Notes</description>
        <name>LeadNotes</name>
        <dataType>String</dataType>
        <expression>{!Get_the_Related_Lead.Notes__c}</expression>
    </formulas>
    <formulas>
        <description>Used to pull the owner&apos;s name</description>
        <name>OwnerName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Owner:User.FirstName} &amp; &quot; &quot; &amp; {!$Record.Owner:User.LastName}</expression>
    </formulas>
    <formulas>
        <description>Used to pass or set a stalled date</description>
        <name>StalledDate</name>
        <dataType>Date</dataType>
        <expression>IF(
AND(
{!varRating} = &quot;Stalled&quot;,
ISBLANK({!varStalledDate})),
{!$Flow.CurrentDate},
{!varStalledDate}
)</expression>
    </formulas>
    <formulas>
        <description>Appending previous notes</description>
        <name>UpdatedNoteContact</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Flow.CurrentDate})
+ BR()
+ &quot;By: &quot; &amp; {!OwnerName}
+ BR()
+{!$Record.Description}+
BR() + BR()
+ {!varContactComment}</expression>
    </formulas>
    <formulas>
