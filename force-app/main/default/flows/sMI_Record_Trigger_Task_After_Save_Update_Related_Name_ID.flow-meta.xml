            <connector>
                <targetReference>Assign_Working_Contacted</targetReference>
            </connector>
            <label>Working - Contacted</label>
        </rules>
        <rules>
            <name>Closed_Nurture</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.SalesLoft1__Call_Disposition__c</leftValueReference>
