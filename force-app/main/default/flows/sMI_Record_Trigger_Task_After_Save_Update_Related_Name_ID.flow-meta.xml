                <leftValueReference>$Record.SalesLoft1__Call_Disposition__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>No Answer - No Voicemail</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_the_Related_Lead.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed - New Opportunity</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_the_Related_Lead.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed - Additional Contact</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Working_Not_Contacted</targetReference>
            </connector>
            <label>Working - Not Contacted</label>
