<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <environments>Default</environments>
    <formulas>
        <name>ACV</name>
        <dataType>Currency</dataType>
        <expression>IF(
ISPICKVAL({!$Record.Product2.Product_Category__c}, &quot;Recurring&quot;),
{!MRR} * 12,
0
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>MRR</name>
        <dataType>Currency</dataType>
        <expression>IF(
ISPICKVAL({!$Record.Product2.Product_Category__c}, &quot;Recurring&quot;),
(
({!$Record.UnitPrice} * {!$Record.Quantity}) 
* 
(1 - ({!$Record.Discount} / 100)) /  {!$Record.Quote.Contract_Length__c}),
0
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>OneTime</name>
        <dataType>Currency</dataType>
        <expression>IF(
ISPICKVAL({!$Record.Product2.Product_Category__c}, &quot;Recurring&quot;),
0,
{!TCV}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TCV</name>
        <dataType>Currency</dataType>
        <expression>({!$Record.UnitPrice} * {!$Record.Quantity}) * (1 - ({!$Record.Discount} / 100))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>sMI - Currency Calculations {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sMI - Currency Calculations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Calculate_Currency_Values</name>
        <label>Calculate Currency Values</label>
        <locationX>176</locationX>
        <locationY>323</locationY>
        <inputAssignments>
            <field>ACV__c</field>
            <value>
                <elementReference>ACV</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>MRR__c</field>
            <value>
                <elementReference>MRR</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>One_Time_Fee__c</field>
            <value>
                <elementReference>OneTime</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>TCV__c</field>
            <value>
                <elementReference>TCV</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Calculate_Currency_Values</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>UnitPrice</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>QuoteLineItem</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
</Flow>
