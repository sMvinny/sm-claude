    <description>Used as an action button on the Contact to create an opportunity.</description>
    <formulas>
        <description>Formula to properly set funnel group and used for sourcing data.</description>
        <name>sMFunnelGroupFormula</name>
        <dataType>String</dataType>
        <expression>IF(
      ISBLANK(TEXT({!Get_Contact_Record.sM_Funnel_Group__c})) ,
&quot;AE Prospecting&quot;, TEXT({!Get_Contact_Record.sM_Funnel_Group__c}))</expression>
    </formulas>
    <formulas>
        <description>Formula to properly set sM-Lead Category for sourcing data.</description>
        <name>sMLeadCategoryFormula</name>
        <dataType>String</dataType>
        <expression>IF(
      ISBLANK(TEXT({!Get_Contact_Record.sM_Funnel_Group__c})) ,
&quot;Outbound&quot;, TEXT({!Get_Contact_Record.sM_Lead_Category__c}))</expression>
    </formulas>
    <formulas>
        <description>Formula to properly set sM-Source Type for sourcing data.</description>
        <name>sMSourceTypeFormula</name>
        <dataType>String</dataType>
        <expression>IF(
      ISBLANK(TEXT({!Get_Contact_Record.sM_Funnel_Group__c})) ,
&quot;Existing Contact Unidentified Source Type Data &quot;, {!Get_Contact_Record.sM_Source_Type__c})</expression>
    </formulas>
    <formulas>
        <description>Formula to properly set sM-Sub Lead Source for sourcing data.</description>
        <name>sMSubLeadSourceFormula</name>
        <dataType>String</dataType>
        <expression>IF(
      ISBLANK(TEXT({!Get_Contact_Record.sM_Funnel_Group__c})) ,
&quot;Existing Contact Unidentified Sub Lead Source Data &quot;, {!Get_Contact_Record.sM_Sub_Lead_Source__c})</expression>
    </formulas>
    <formulas>
        <description>Used as a formula to store the User ID of the User using this action button.</description>
        <name>UserId</name>
        <dataType>String</dataType>
        <expression>{!$User.Id}</expression>
    </formulas>
