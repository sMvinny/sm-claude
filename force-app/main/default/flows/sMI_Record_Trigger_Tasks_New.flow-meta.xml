        <description>Used to copy Salesloft Type formula</description>
        <name>SalesloftType</name>
        <dataType>String</dataType>
        <expression>IF(BEGINS({!$Record.Subject},&apos;Email:&apos;),&apos;Email&apos;,
IF(BEGINS({!$Record.Subject},&apos;Sent Email:&apos;),&apos;Email&apos;,
IF(BEGINS({!$Record.Subject},&apos;Call&apos;),&apos;Call&apos;,
IF(BEGINS({!$Record.Subject},&apos;LinkedIn Sales Navigator: InMail&apos;),&apos;LinkedIn - InMail&apos;,
IF(BEGINS({!$Record.Subject},&apos;LinkedIn Sales Navigator: Research&apos;),&apos;LinkedIn - Research&apos;,
IF(BEGINS({!$Record.Subject},&apos;LinkedIn Sales Navigator: Connection Request&apos;),&apos;LinkedIn - Connection Request&apos;,
IF(BEGINS({!$Record.Subject},&apos;LinkedIn Sales Navigator: Ask for an Introduction&apos;),&apos;LinkedIn - Ask for an Introduction&apos;,
IF(BEGINS({!$Record.Subject},&apos;Meeting Booked:&apos;),&apos;Meeting&apos;,
IF(BEGINS({!$Record.Subject},&apos;Other:&apos;),&apos;Other&apos;,
IF(BEGINS({!$Record.Subject},&apos;Reply:&apos;),&apos;Reply&apos;,
IF(BEGINS({!$Record.Subject},&apos;Note&apos;),&apos;Note&apos;,
IF(BEGINS({!$Record.Subject},&apos;Hot Lead:&apos;),&apos;Hot Lead&apos;,
IF(BEGINS({!$Record.Subject},&apos;Recording:&apos;),&apos;Conversation Intelligence Recording&apos;,
IF(BEGINS({!$Record.Subject},&apos;Message:&apos;),&apos;Message&apos;,
NULL))))))))))))))</expression>
