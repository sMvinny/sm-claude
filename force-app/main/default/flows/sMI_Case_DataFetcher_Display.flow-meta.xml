    <environments>Default</environments>
    <formulas>
        <name>AllottedHoursQuery</name>
        <dataType>String</dataType>
        <expression>&quot;Select Account__c, Id, Name, Month_Year__c, Display__c, Hours_Allotted__c FROM Hours_Allotment__c Where Display__c = &apos;This Month&apos; AND Account__c = &apos;&quot;+{!dataFetcherCase.firstRetrievedRecord.AccountId}+&quot;&apos; &quot;</expression>
    </formulas>
    <formulas>
        <name>CaseQuery</name>
        <dataType>String</dataType>
        <expression>&quot;Select AccountId, Id, Subject, Account.Name FROM Case Where Id = &apos;&quot;+{!recordId}+&quot;&apos; &quot;</expression>
    </formulas>
    <formulas>
        <name>HourUsage</name>
        <dataType>Number</dataType>
        <expression>({!dataFetcherTimeEntries.aggQueryResult} / {!dataFetcherAllottedHours.firstRetrievedRecord.Hours_Allotted__c}) * 100</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>TimeEntriesQuery</name>
        <dataType>String</dataType>
        <expression>&quot;Select SUM(Total_Case_Hours__c) FROM Time_Entries__c Where Display__c = &apos;This Month&apos; AND Do_Not_Include_in_Hours__c = FALSE AND Account__c = &apos;&quot;+{!dataFetcherCase.firstRetrievedRecord.AccountId}+&quot;&apos; &quot;</expression>
    </formulas>
    <interviewLabel>sMI - Case DataFetcher Display {!$Flow.CurrentDateTime}</interviewLabel>
