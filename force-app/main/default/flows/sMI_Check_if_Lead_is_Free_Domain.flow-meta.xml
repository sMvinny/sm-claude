<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>65.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Record_to_Free_Domain</name>
        <label>Set Record to Free Domain</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Email_is_Free_Domain__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Set_Record_to_Not_Free_Domain</name>
        <label>Set Record to Not Free Domain</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.Email_is_Free_Domain__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Is_there_Email_Address</name>
        <label>Is there Email Address?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Record_has_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Free_Domain_Match</targetReference>
            </connector>
            <label>Record has Email</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_Free_Domain_Found</name>
        <label>Was Free Domain Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Record_to_Not_Free_Domain</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not Free Domain</defaultConnectorLabel>
        <rules>
            <name>Yes_found_Free_Domain</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Free_Domain_Match.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Record_to_Free_Domain</targetReference>
            </connector>
            <label>Yes found Free Domain</label>
        </rules>
    </decisions>
    <description>When a Lead is created or email is changed. Check if it matches to a free domain or not.

Created by VPP</description>
    <environments>Default</environments>
    <formulas>
        <name>EmailDomain_form</name>
        <dataType>String</dataType>
        <expression>RIGHT(
  {!$Record.Email},
  LEN({!$Record.Email}) - FIND(&quot;@&quot;, {!$Record.Email})
)</expression>
    </formulas>
    <interviewLabel>sMI - Check if Lead is Free Domain {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sMI - Check if Lead is Free Domain</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Free_Domain_Match</name>
        <label>Get Free Domain Match</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Free_Domain_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Domain__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>EmailDomain_form</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>FreeDomain__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Domain__c</queriedFields>
        <sortField>Domain__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_there_Email_Address</targetReference>
        </connector>
        <filterFormula>OR(
ISNEW() = TRUE,
ISCHANGED({!$Record.Email})
)</filterFormula>
        <object>Lead</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>1000</triggerOrder>
</Flow>
