    <description>checks if contact exists if email-to-case; if not, parses out full name into first/last &amp; creates contact, associates with case &amp; account

Updated by VPP
Case #00005674

Updated internal message to remove the long description</description>
    <environments>Default</environments>
    <formulas>
        <description>500 character-limit description formula</description>
        <name>Case_ShortDescription</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.Description},500)</expression>
    </formulas>
    <formulas>
        <name>ContactDomain</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.SuppliedEmail}, LEN({!$Record.SuppliedEmail}) - FIND(&quot;@&quot;,{!$Record.SuppliedEmail}))</expression>
    </formulas>
    <formulas>
        <name>formula_FirstName</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Record.SuppliedName}, FIND(&quot; &quot;, {!$Record.SuppliedName}))</expression>
    </formulas>
    <formulas>
        <name>formula_LastName</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.SuppliedName},LEN({!$Record.SuppliedName})-FIND(&quot; &quot;,{!$Record.SuppliedName}))</expression>
    </formulas>
