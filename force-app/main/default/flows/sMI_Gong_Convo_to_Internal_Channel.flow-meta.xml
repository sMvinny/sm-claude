    <decisions>
        <name>Does_Account_also_want_in_Support_Channel</name>
        <label>Does Account also want in Support Channel?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Send_to_Support_Channel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Gong__Primary_Account__r.SupportSlackID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Gong__Primary_Account__r.Share_Slack_Call_to_Support_Channel__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Call_Info_to_Support_Channel</targetReference>
            </connector>
            <label>Send to Support Channel</label>
        </rules>
    </decisions>
    <decisions>
        <name>Does_Account_have_Internal_Slack_Channel</name>
        <label>Does Account have Internal Slack Channel?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Yes_Account_has_Internal_Slack_Channel</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Gong__Primary_Account__r.Slack_Internal_ID__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Call_Info_to_Internal_Channel</targetReference>
            </connector>
            <label>Yes, Account has Internal Slack Channel</label>
        </rules>
    </decisions>
    <description>Process that if an Account has a Slack Internal ID go ahead and share conversation details to that channel

Updated by VPP
Added ability if customer also want to receive Gong convo in their Support Channel</description>
