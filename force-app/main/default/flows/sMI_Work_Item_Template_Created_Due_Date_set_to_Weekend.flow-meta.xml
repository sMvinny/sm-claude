<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Correct_Saturday_Due_Date</name>
        <label>Correct Saturday Due Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.DueDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>form_DuePlus2</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Correct_Sunday_Due_Date</name>
        <label>Correct Sunday Due Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>$Record.DueDate__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>form_DuePlus1</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Due_Date_is_Weekend</name>
        <label>Due Date is Weekend</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Saturday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>form_Weekday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>7.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Correct_Saturday_Due_Date</targetReference>
            </connector>
            <label>Saturday</label>
        </rules>
        <rules>
            <name>Sunday</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>form_Weekday</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Correct_Sunday_Due_Date</targetReference>
            </connector>
            <label>Sunday</label>
        </rules>
    </decisions>
    <description>Process used to update Work Item due dates when created from a template where the date falls on a weekend.</description>
    <environments>Default</environments>
    <formulas>
        <name>form_DuePlus1</name>
        <dataType>Date</dataType>
        <expression>{!$Record.DueDate__c} + 1</expression>
    </formulas>
    <formulas>
        <name>form_DuePlus2</name>
        <dataType>Date</dataType>
        <expression>{!$Record.DueDate__c} + 2</expression>
    </formulas>
    <formulas>
        <name>form_Weekday</name>
        <dataType>Number</dataType>
        <expression>WEEKDAY({!$Record.DueDate__c})</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>sMI - Work Item - Template Created Due Date set to Weekend {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sMI - Work Item - Template Created Due Date set to Weekend</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Due_Date_is_Weekend</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>LinkedWorkItemTemplate__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>WorkItem__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>50</triggerOrder>
</Flow>
