    <description>When an email message has been created and Try Sending to Slack is changed to TRUE. Pass to Slack Case Channel.</description>
    <environments>Default</environments>
    <formulas>
        <name>LatestReplyOnly</name>
        <dataType>String</dataType>
        <expression>TRIM(
  IF(
    CONTAINS({!$Record.TextBody}, &quot;________________________________&quot;),
    LEFT({!$Record.TextBody}, FIND(&quot;________________________________&quot;, {!$Record.TextBody}) - 1),
    IF(
      CONTAINS({!$Record.TextBody}, &quot;From:&quot;),
      LEFT({!$Record.TextBody}, FIND(&quot;From:&quot;, {!$Record.TextBody}) - 1),
      IF(
        CONTAINS({!$Record.TextBody}, &quot;On &quot;) &amp;&amp; CONTAINS({!$Record.TextBody}, &quot; wrote:&quot;),
        LEFT({!$Record.TextBody}, FIND(&quot;On &quot;, {!$Record.TextBody}) - 1),
        {!$Record.TextBody}
      )
    )
  )
)</expression>
    </formulas>
    <interviewLabel>sMI - Email Message Send Slack Message to Channel {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sMI - Email Message Send Slack Message to Channel</label>
