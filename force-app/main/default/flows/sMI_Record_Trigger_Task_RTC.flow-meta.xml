    <formulas>
        <description>Used for additional data comparison values</description>
        <name>RTC_Contact_Formula</name>
        <dataType>Date</dataType>
        <expression>IF(
    ISPICKVAL({!Get_Contact.scaleMatters__Created_Rating__c}, &quot;Lead 2&quot;),
    {!Get_Contact.scaleMatters__Lead_2_Date__c},
    IF(
        ISBLANK({!RTC_First_Formula}),
        NULL,
        IF(
            AND(
                ISPICKVAL({!Get_Contact.scaleMatters__Created_Rating__c}, &quot;Lead 0&quot;),
                NOT(ISBLANK({!Get_Contact.scaleMatters__Lead_0_Date__c})),
                {!RTC_First_Formula} &lt; {!Get_Contact.scaleMatters__Lead_0_Date__c}
            ),
            {!Get_Contact.scaleMatters__Lead_0_Date__c},
            IF(
                AND(
                    ISPICKVAL({!Get_Contact.scaleMatters__Created_Rating__c}, &quot;Lead 1&quot;),
                   NOT(ISBLANK({!Get_Contact.scaleMatters__Lead_1_Date__c})),
                    {!RTC_First_Formula} &lt; {!Get_Contact.scaleMatters__Lead_1_Date__c}
                ),
                {!Get_Contact.scaleMatters__Lead_1_Date__c},
                IF(
                    AND(
                        ISPICKVAL({!Get_Contact.scaleMatters__Created_Rating__c}, &quot;Lead 0&quot;),
                        {!RTC_First_Formula} &gt;= {!Get_Contact.scaleMatters__Lead_0_Date__c}
                    ),
                    {!RTC_First_Formula},
                    IF(
                        AND(
                            ISPICKVAL({!Get_Contact.scaleMatters__Created_Rating__c}, &quot;Lead 1&quot;),
                            {!RTC_First_Formula} &gt;= {!Get_Contact.scaleMatters__Lead_1_Date__c}
                        ),
                        {!RTC_First_Formula},
                        {!RTC_First_Formula}
                    )
                )
            )
        )
    )
)</expression>
    </formulas>
    <formulas>
        <description>Used to compare data and set a value</description>
        <name>RTC_First_Formula</name>
        <dataType>Date</dataType>
        <expression>IF(
    AND(
        NOT(ISBLANK({!Get_Other_Related_Tasks.Id})),
        NOT(ISBLANK({!Get_Other_Related_Events.Id})),
        {!Get_Other_Related_Tasks.ActivityDate} &lt; DATEVALUE({!Get_Other_Related_Events.CreatedDate})
    ),
    {!Get_Other_Related_Tasks.ActivityDate},
    IF(
        AND(
            NOT(ISBLANK({!Get_Other_Related_Tasks.Id})),
            NOT(ISBLANK({!Get_Other_Related_Events.Id})),
            {!Get_Other_Related_Tasks.ActivityDate} &gt; DATEVALUE({!Get_Other_Related_Events.CreatedDate})
        ),
        DATEVALUE({!Get_Other_Related_Events.CreatedDate}),
        IF(
            AND(
                NOT(ISBLANK({!Get_Other_Related_Tasks.Id})),
                ISBLANK({!Get_Other_Related_Events.Id})
            ),
            {!Get_Other_Related_Tasks.ActivityDate},
            IF(
                AND(
                    ISBLANK({!Get_Other_Related_Tasks.Id}),
                    NOT(ISBLANK({!Get_Other_Related_Events.Id}))
                ),
                DATEVALUE({!Get_Other_Related_Events.CreatedDate}),
                IF(
                    AND(
                        ISBLANK({!Get_Other_Related_Tasks.Id}),
                        ISBLANK({!Get_Other_Related_Events.Id})
                    ),
                        NULL,
                        NULL
                )
            )
        )
    )
)</expression>
    </formulas>
