    <description>This flow will check New Lead for possible matches and will send an email alert to the owner once there was a match on Account or Contact.</description>
    <formulas>
        <description>Use to store Lead Clean Company Name</description>
        <name>varLeadCleanCompanyName</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!Get_Lead.Company},&quot;,&quot;),
    LEFT( {!Get_Lead.Company}, FIND (&quot;,&quot;,{!Get_Lead.Company})-1),
    {!Get_Lead.Company}
)</expression>
    </formulas>
    <formulas>
        <description>Use to store Lead Email Domain</description>
        <name>varLeadEmailDomain</name>
        <dataType>String</dataType>
        <expression>IF(
   CONTAINS({!Get_Lead.Email}, &quot;gmail&quot;) ||
   CONTAINS({!Get_Lead.Email}, &quot;yahoo&quot;) ||
   CONTAINS({!Get_Lead.Email}, &quot;hotmail&quot;) ||
   CONTAINS({!Get_Lead.Email}, &quot;outlook&quot;),
   NULL,
   SUBSTITUTE({!Get_Lead.Email}, LEFT({!Get_Lead.Email}, FIND(&quot;@&quot;, {!Get_Lead.Email})),NULL)
   )</expression>
    </formulas>
    <formulas>
        <description>Use to store Lead Website Domain</description>
        <name>varLeadWebsiteDomain</name>
        <dataType>String</dataType>
        <expression>IF(
   CONTAINS({!Get_Lead.Website}, &quot;www.&quot;),
   MID({!Get_Lead.Website}, FIND(&quot;www.&quot;, {!Get_Lead.Website}, 1)+4, (LEN({!Get_Lead.Website}) -
   FIND(&quot;www.&quot;, {!Get_Lead.Website}, 1)+4)),
   SUBSTITUTE(
     {!Get_Lead.Website}, LEFT({!Get_Lead.Website}, FIND(&quot;https://&quot;, {!Get_Lead.Website})+7),
     NULL)
 )</expression>
    </formulas>
