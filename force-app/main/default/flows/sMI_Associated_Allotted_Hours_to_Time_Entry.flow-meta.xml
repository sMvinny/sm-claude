<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Log_Error</name>
        <label>Log Error</label>
        <locationX>314</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>$Record.Allotted_Time_Message__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>No Allotted Found for this Account</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>Update_Time_Entry_with_Allotted_Hour</name>
        <label>Update Time Entry with Allotted Hour</label>
        <locationX>50</locationX>
        <locationY>803</locationY>
        <assignmentItems>
            <assignToReference>$Record.Allotted_Time__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account_s_Allotted_Hours.Hours_Allotted__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>$Record.Hours_Allotment__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_Account_s_Allotted_Hours.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>Check_Allotted_Hours</name>
        <label>Check Allotted Hours</label>
        <locationX>182</locationX>
        <locationY>695</locationY>
        <defaultConnector>
            <targetReference>Log_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>End No Allotted</defaultConnectorLabel>
        <rules>
            <name>Was_Allotted_Hours_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account_s_Allotted_Hours.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Time_Entry_with_Allotted_Hour</targetReference>
            </connector>
            <label>Was Allotted Hours Found?</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_or_Edit</name>
        <label>New or Edit?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>New_Entry</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_s_Allotted_Hours</targetReference>
            </connector>
            <label>New Entry</label>
        </rules>
        <rules>
            <name>Edit_of_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Time_Entry_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_s_Allotted_Hours</targetReference>
            </connector>
            <label>Edit of Date</label>
        </rules>
        <rules>
            <name>Account_Changed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Account_s_Allotted_Hours</targetReference>
            </connector>
            <label>Account Changed</label>
        </rules>
    </decisions>
    <description>When a user submits time entry this will look at the Hours Allotment to collect the hours that customer has for the month.

Created by VPP
Case #00004890</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>IF(
ISNEW(),
TRUE,
FALSE
)</expression>
    </formulas>
    <formulas>
        <name>TimeEntryMonth</name>
        <dataType>String</dataType>
        <expression>RIGHT(&quot;0&quot; &amp; TEXT(MONTH({!$Record.Time_Entry_Date__c})), 2)</expression>
    </formulas>
    <formulas>
        <name>TimeEntryYear</name>
        <dataType>String</dataType>
        <expression>TEXT(YEAR({!$Record.Time_Entry_Date__c}))</expression>
    </formulas>
    <interviewLabel>sMI - Associated Allotted Hours to Time Entry {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sMI - Associated Allotted Hours to Time Entry</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Account_s_Allotted_Hours</name>
        <label>Get Account&apos;s Allotted Hours</label>
        <locationX>182</locationX>
        <locationY>587</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_Allotted_Hours</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Month__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TimeEntryMonth</elementReference>
            </value>
        </filters>
        <filters>
            <field>Year__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>TimeEntryYear</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Hours_Allotment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>New_or_Edit</targetReference>
        </connector>
        <object>Time_Entries__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <triggerOrder>100</triggerOrder>
</Flow>
