<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Contact_is_Found</name>
        <label>Contact is Found?</label>
        <locationX>182</locationX>
        <locationY>575</locationY>
        <defaultConnector>
            <targetReference>Upd_Case_Account</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No, Contact Not Found</defaultConnectorLabel>
        <rules>
            <name>Yes_Found_Contact</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Contact.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case</targetReference>
            </connector>
            <label>Yes, Found Contact</label>
        </rules>
    </decisions>
    <description>Updates contact and account from email-to-case</description>
    <environments>Default</environments>
    <formulas>
        <name>SuppliedEmailDomain</name>
        <dataType>String</dataType>
        <expression>RIGHT({!$Record.SuppliedEmail}, LEN({!$Record.SuppliedEmail}) - FIND(&quot;@&quot;,{!$Record.SuppliedEmail}))</expression>
    </formulas>
    <interviewLabel>Record Triggered Flow: Case: Update Account and Contact from Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Record Triggered Flow: Case: Update Account and Contact from Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
