    <description>This flow controls the Round Robin assignment of Leads.
======
Comment - 5/22/2023 - VPP
Updated when Round Robin used to assign records also updating Record Owner, Record Owner Role, user Source and user source role.</description>
    <environments>Default</environments>
    <formulas>
        <name>PartnerEmailDomain_Formula</name>
        <dataType>String</dataType>
        <expression>IF(
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;gmail&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;yahoo&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c},&quot;hotmail&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;live.com&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;qq.com&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;163.com&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;mail.com&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;@me.com&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;icloud.com&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;outlook&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;aol.com&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;mac.com&quot;) ||
CONTAINS({!$Record.Partner_Submitter_Email__c}, &quot;gmx.net&quot;),
NULL,
SUBSTITUTE({!$Record.Partner_Submitter_Email__c}, LEFT({!$Record.Partner_Submitter_Email__c}, FIND(&quot;@&quot;, {!$Record.Partner_Submitter_Email__c})),NULL)
)</expression>
    </formulas>
