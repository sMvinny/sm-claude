    <description>Used to set the Lead Source</description>
    <environments>Default</environments>
    <formulas>
        <description>Combining both HubSpot Original Source Drill Down 1 and 2</description>
        <name>DrillDown1and2</name>
        <dataType>String</dataType>
        <expression>{!$Record.HS_Original_source_drilldown_1__c}+ &quot; - &quot; +{!$Record.HS_Original_source_drilldown_2__c}</expression>
    </formulas>
    <formulas>
        <description>Used to simply group non inbound lead sources.</description>
        <name>NonInboundForm</name>
        <dataType>Boolean</dataType>
        <expression>IF(
     OR(
             ISPICKVAL({!$Record.LeadSource},&quot;SDR Prospecting&quot;),
             ISPICKVAL({!$Record.LeadSource}, &quot;AE Prospecting&quot;),
             ISPICKVAL({!$Record.LeadSource}, &quot;3rd Party Prospecting&quot;),
             ISPICKVAL({!$Record.LeadSource}, &quot;Social Prospecting&quot;),
             ISPICKVAL({!$Record.LeadSource}, &quot;Event&quot;),
             ISPICKVAL({!$Record.LeadSource}, &quot;Client/Customer Referral&quot;),
             ISPICKVAL({!$Record.LeadSource}, &quot;Employee Referral&quot;),
             ISPICKVAL({!$Record.LeadSource}, &quot;Partner Referral&quot;)),
TRUE, FALSE)</expression>
    </formulas>
    <formulas>
        <description>Determines whether or not record is new</description>
        <name>RecordIsNew</name>
        <dataType>Boolean</dataType>
        <expression>IF(
ISNEW(),
TRUE,FALSE
)</expression>
    </formulas>
