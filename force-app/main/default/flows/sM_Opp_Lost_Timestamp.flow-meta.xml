<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>Looking at the stage of opportunity and if Lost Timestamp is already set or not.</description>
        <name>Decision_Stage_and_Lost_Timestamp</name>
        <label>Decision - Stage and Lost Timestamp</label>
        <locationX>454</locationX>
        <locationY>204</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lost_Opp_without_Lost_Timestamp</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 8b - Closed lost confirmed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 8c - Closed Lost Ghosted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.sM_Lost_Timestamp__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Lost_Timestamp</targetReference>
            </connector>
            <label>Lost Opp without Lost Timestamp</label>
        </rules>
        <rules>
            <name>Won_with_Lost_Timestamp</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 8a - Closed won</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 9 - Client accepted win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.sM_Lost_Timestamp__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Lost_Timestamp</targetReference>
            </connector>
            <label>Won with Lost Timestamp</label>
        </rules>
        <rules>
            <name>Open_with_Lost_Timestamp</name>
            <conditionLogic>(1 OR 2 OR 3 OR 4 OR 5 OR 6 OR 7) AND 8</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 1 - Fit, Intent, and Engagement (SQL)</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 2 - Clarity of process/authority</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 3 - Active engagement in process</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 4 - Business case review</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 5 - Proposal</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 6 - Active negotiations</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Opp 7 - Verbal indication of win</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opp.sM_Lost_Timestamp__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Lost_Timestamp</targetReference>
            </connector>
            <label>Open with Lost Timestamp</label>
        </rules>
    </decisions>
    <description>Used to update the record to avoid reps from being able to reopen opportunities.</description>
    <interviewLabel>sM - Opp - Lost Timestamp {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sM - Opp - Lost Timestamp</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get opportunity that started the flow</description>
        <name>Get_Opp</name>
        <label>Get Opp</label>
        <locationX>237</locationX>
        <locationY>202</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Decision_Stage_and_Lost_Timestamp</targetReference>
