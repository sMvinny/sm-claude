    <description>Creates an Expansion opportunity when an opportunity is closed won with Gap Analysis being the only product</description>
    <environments>Default</environments>
    <formulas>
        <name>AcctOpenOpp</name>
        <dataType>Number</dataType>
        <expression>IF(
ISBLANK({!$Record.Account.scaleMatters__Open_Opportunities__c}),0,
{!$Record.Account.scaleMatters__Open_Opportunities__c}
)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CloseDateFormula</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 60</expression>
    </formulas>
    <formulas>
        <name>OppNameFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.Account.Name} &amp; &quot; - &quot; &amp; 
CASE(
MONTH({!$Flow.CurrentDate}),
1, &quot;Jan&quot;,
2, &quot;Feb&quot;,
3, &quot;Mar&quot;, 
4, &quot;Apr&quot;, 
5, &quot;May&quot;, 
6, &quot;June&quot;,
7, &quot;July&quot;,
8, &quot;Aug&quot;,
9, &quot;Sep&quot;,
10, &quot;Oct&quot;,
11, &quot;Nov&quot;,
12, &quot;Dec&quot;,
&quot;NONE&quot;)
&amp; &quot;&apos;&quot; &amp; 
RIGHT(TEXT(YEAR({!$Flow.CurrentDate})),2)
&amp;&quot;.&quot;&amp; TEXT({!AcctOpenOpp}+1)</expression>
    </formulas>
    <interviewLabel>sM - Create Gap Analysis Expansion Opp {!$Flow.CurrentDateTime}</interviewLabel>
