                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed - Nurture</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed - Out of ICP Scope</stringValue>
                </rightValue>
