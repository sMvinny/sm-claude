    <description>This flow will check New Lead for possible matches and will send an email alert to the owner once there was a match on Account or Contact.</description>
    <formulas>
        <description>Use to store Lead Clean Company Name</description>
        <name>varLeadCleanCompanyName</name>
        <dataType>String</dataType>
        <expression>IF(
    CONTAINS({!$Record.Company},&quot;,&quot;),
    LEFT( {!$Record.Company}, FIND (&quot;,&quot;,{!$Record.Company})-1),
    {!$Record.Company}
)</expression>
    </formulas>
    <formulas>
        <description>Use to store Lead Email Domain</description>
        <name>varLeadEmailDomain</name>
        <dataType>String</dataType>
        <expression>IF(
   CONTAINS({!$Record.Email}, &quot;gmail&quot;) ||
   CONTAINS({!$Record.Email}, &quot;yahoo&quot;) ||
   CONTAINS({!$Record.Email}, &quot;hotmail&quot;) ||
   CONTAINS({!$Record.Email}, &quot;outlook&quot;),
   NULL,
   SUBSTITUTE({!$Record.Email}, LEFT({!$Record.Email}, FIND(&quot;@&quot;, {!$Record.Email})),NULL)
   )</expression>
    </formulas>
    <formulas>
        <description>Use to store Lead Website Domain</description>
        <name>varLeadWebsiteDomain</name>
        <dataType>String</dataType>
        <expression>IF(
   CONTAINS({!$Record.Website}, &quot;www.&quot;),
   MID({!$Record.Website}, FIND(&quot;www.&quot;, {!$Record.Website}, 1)+4, (LEN({!$Record.Website}) -
   FIND(&quot;www.&quot;, {!$Record.Website}, 1)+4)),
   SUBSTITUTE(
     {!$Record.Website}, LEFT({!$Record.Website}, FIND(&quot;https://&quot;, {!$Record.Website})+7),
     NULL)
 )</expression>
    </formulas>
