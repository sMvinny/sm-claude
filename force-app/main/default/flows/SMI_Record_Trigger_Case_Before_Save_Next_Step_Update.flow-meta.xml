<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Storing prior and current values</description>
        <name>Assigning_Variables</name>
        <label>Assigning Variables</label>
        <locationX>50</locationX>
        <locationY>395</locationY>
        <assignmentItems>
            <assignToReference>Var_NextSteps</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Next_Steps__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>Var_PreviousDescription</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Description_Internal__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Update_Internal_Description</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Process to continuously update internal description</description>
        <name>Update_Internal_Description</name>
        <label>Update Internal Description</label>
        <locationX>50</locationX>
        <locationY>503</locationY>
        <assignmentItems>
            <assignToReference>$Record.Description_Internal__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>NextStep_Template</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <description>Checking if the field is blank previously</description>
        <name>Is_Next_Step_Prior_Blank_or_Did_it_change</name>
        <label>Is Next Step Prior Blank or Did it change?</label>
        <locationX>182</locationX>
        <locationY>287</locationY>
        <defaultConnectorLabel>End</defaultConnectorLabel>
        <rules>
            <name>Prior_is_NOT_blank_Or_Changed</name>
            <conditionLogic>1 OR (2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record__Prior.Next_Steps__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Next_Steps__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Next_Steps__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assigning_Variables</targetReference>
            </connector>
            <label>Prior is NOT blank Or Changed</label>
        </rules>
    </decisions>
    <description>When Next Step field is updated, we copy value to internal description

Created by: Carlo Centeno</description>
    <environments>Default</environments>
    <interviewLabel>Record-Trigger: &lt;Object Name&gt; Before Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SMI - Record-Trigger: Case Before Save - Next Step Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Is_Next_Step_Prior_Blank_or_Did_it_change</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Next_Steps__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Next_Steps__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <description>used to combine text</description>
        <name>NextStep_Template</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>&lt;p&gt;{!$Flow.CurrentDateTime}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;By: {!$User.FirstName} {!$User.LastName}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!Var_NextSteps}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;=============&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;{!Var_PreviousDescription}&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;</text>
    </textTemplates>
    <triggerOrder>1000</triggerOrder>
    <variables>
        <description>used to store values</description>
        <name>Var_NextSteps</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <description>used to store value</description>
        <name>Var_PreviousDescription</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
