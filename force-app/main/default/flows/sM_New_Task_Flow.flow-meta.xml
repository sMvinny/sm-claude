    <decisions>
        <name>Sent_or_Received_Email</name>
        <label>Sent or Received Email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Set_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Received_Email</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>TaskType_form</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email Received</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Working - Awaiting Response</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Received_Email_Status</targetReference>
            </connector>
            <label>Received Email</label>
        </rules>
        <rules>
            <name>Out_Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>TaskType_form</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email Sent</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varStatus</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Open</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Sent_Email_Status</targetReference>
            </connector>
            <label>Out Email</label>
        </rules>
    </decisions>
    <description>Flow used to set some new task values pulling in from the related Lead or Contact</description>
    <environments>Default</environments>
    <formulas>
        <description>Used to pull the owner&apos;s name</description>
        <name>OwnerName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Owner:User.FirstName} &amp; &quot; &quot; &amp; {!$Record.Owner:User.LastName}</expression>
    </formulas>
    <formulas>
        <name>TaskType_form</name>
        <dataType>String</dataType>
        <expression>IF(
  OR(
    BEGINS({!$Record.Subject}, &quot;Email:&quot;),
    BEGINS({!$Record.Subject}, &quot;Sent Email:&quot;),
    BEGINS({!$Record.Subject}, &quot;[Gong Out]&quot;)
  ),
  &quot;Email Sent&quot;,

IF(
  OR(
    BEGINS({!$Record.Subject}, &quot;Reply:&quot;),
    BEGINS({!$Record.Subject}, &quot;[Gong In]&quot;)
  ),
  &quot;Email Received&quot;,

IF(
  OR(
    BEGINS({!$Record.Subject}, &quot;Call&quot;),
    BEGINS({!$Record.Subject}, &quot;[Gong Inbound]&quot;),
    BEGINS({!$Record.Subject}, &quot;[Gong Outbound]&quot;)
  ),
  &quot;Call&quot;,

IF(
  OR(
    BEGINS({!$Record.Subject}, &quot;LinkedIn Sales Navigator: InMail&quot;),
    BEGINS({!$Record.Subject}, &quot;LinkedIn Sales Navigator: Research&quot;),
    BEGINS({!$Record.Subject}, &quot;LinkedIn Sales Navigator: Connection Request&quot;),
    BEGINS({!$Record.Subject}, &quot;LinkedIn Sales Navigator: Ask for an Introduction&quot;)
  ),
  &quot;LinkedIn&quot;,

&quot;Other&quot;
))))</expression>
    </formulas>
