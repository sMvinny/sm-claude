    <formulas>
        <description>Used to see if an opportunity was closed les than 30 days ago</description>
        <name>CloseDateCheck</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} - 30</expression>
    </formulas>
    <formulas>
        <description>Used to set the close date 90 days from Today</description>
        <name>CloseDateFormula</name>
        <dataType>Date</dataType>
        <expression>{!$Flow.CurrentDate} + 90</expression>
    </formulas>
    <formulas>
        <description>used to set cycle type</description>
        <name>CycleTypeFormula</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK(TEXT({!Get_Contact_for_Opp_creation.sM_Cycle_Type__c})),
&quot;New - Contact&quot; , TEXT({!Get_Contact_for_Opp_creation.sM_Cycle_Type__c})
)</expression>
    </formulas>
    <formulas>
        <description>Used to check if Account Type to set default Opportunity Type value</description>
        <name>DefaultOppType</name>
        <dataType>String</dataType>
        <expression>CASE(
{!Get_Contact.Account.Type},
&quot;Prospect&quot;, &quot;New Business&quot;,
&quot;Customer&quot;,&quot;Upsell&quot;,
&quot;Partner&quot;,&quot;&quot;,
&quot;Former Customer&quot;,&quot;New Business&quot;,
&quot;Competitor&quot;,&quot;&quot;,
&quot;New Business&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Used to set Funnel Group</description>
        <name>FunnelGroupFormula</name>
        <dataType>String</dataType>
        <expression>IF(
      ISBLANK(TEXT({!Get_Contact_for_Opp_creation.sM_Funnel_Group__c})) ,
&quot;Prospecting - AE&quot;, TEXT({!Get_Contact_for_Opp_creation.sM_Funnel_Group__c})
)</expression>
    </formulas>
    <formulas>
        <description>Used to set sM-lead Category</description>
        <name>LeadCategoryFormula</name>
        <dataType>String</dataType>
        <expression>IF(
      ISBLANK(TEXT({!Get_Contact_for_Opp_creation.sM_Lead_Category__c})) ,
&quot;Outbound&quot;, TEXT({!Get_Contact_for_Opp_creation.sM_Lead_Category__c})
)</expression>
    </formulas>
    <formulas>
        <description>Used to set Lead Source value</description>
        <name>LeadSourceFormula</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK(TEXT({!Get_Contact_for_Opp_creation.LeadSource})),
&quot;Prospecting - AE&quot;, TEXT({!Get_Contact_for_Opp_creation.LeadSource})
)</expression>
    </formulas>
    <formulas>
        <description>used to set meeting date</description>
        <name>MeetingDateFormula</name>
        <dataType>Date</dataType>
        <expression>IF(
    ISBLANK({!Get_Contact_for_Opp_creation.sM_Meeting_Date__c}),
    {!$Flow.CurrentDate},{!Get_Contact_for_Opp_creation.sM_Meeting_Date__c}
)</expression>
    </formulas>
    <formulas>
        <description>Used to set Meeting Disposition</description>
        <name>MeetingDispositionFormula</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK(TEXT({!Get_Contact_for_Opp_creation.sM_Meeting_Disposition__c})),
&quot;Completed&quot; , TEXT({!Get_Contact_for_Opp_creation.sM_Meeting_Disposition__c})
)</expression>
    </formulas>
    <formulas>
        <description>Used to Set Meeting Source</description>
        <name>MeetingSourceFormula</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!Get_Contact_for_Opp_creation.sM_Meeting_Source__c}),
{!$User.Id}, {!Get_Contact_for_Opp_creation.sM_Meeting_Source__c}
)</expression>
    </formulas>
    <formulas>
        <description>Used to Set meeting Source Role</description>
        <name>MeetingSourceRoleFormula</name>
        <dataType>String</dataType>
        <expression>IF(
   ISBLANK({!Get_Contact_for_Opp_creation.sM_Meeting_Source_Role__c}),
   &quot;Closer&quot;, {!Get_Contact_for_Opp_creation.sM_Meeting_Source_Role__c}
)</expression>
    </formulas>
    <formulas>
        <description>Used to Set meeting Source Role</description>
        <name>MeetingSourceRoleFormulav2</name>
        <dataType>String</dataType>
        <expression>IF(
   ISBLANK({!Get_Contact_for_Opp_creation.sM_Meeting_Source_Role__c}),
   &quot;AE&quot;, 
IF(
{!Get_Contact_for_Opp_creation.sM_Meeting_Source_Role__c} = &quot;Closer&quot;,
&quot;AE&quot;,
{!Get_Contact_for_Opp_creation.sM_Meeting_Source_Role__c}
)
)</expression>
    </formulas>
    <formulas>
        <description>Used to set Opp Name</description>
        <name>OppNameFormula</name>
        <dataType>String</dataType>
        <expression>{!Opportunity_Type} &amp; &quot;-&quot; &amp; {!varAccountName}</expression>
    </formulas>
    <formulas>
        <description>Used to populate if data is missing</description>
        <name>sMUserSourceFormula</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!Get_Contact.sM_User_Source__c}),
{!$User.Id},
{!Get_Contact.sM_User_Source__c}
)</expression>
    </formulas>
    <formulas>
        <description>Used to set value if blank</description>
        <name>sMUserSourceRoleFormula</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!Get_Contact.sM_User_Source_Role__c}),
TEXT({!$User.sM_Current_Role__c}),
{!Get_Contact.sM_User_Source_Role__c}
)</expression>
    </formulas>
    <formulas>
        <description>Used to set SubLead Source value</description>
        <name>SubLeadSourceFormula</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!Get_Contact_for_Opp_creation.sM_Sub_Lead_Source__c}),
&quot;Existing Contact Unidentified Sub Lead Source Data&quot;, {!Get_Contact_for_Opp_creation.sM_Sub_Lead_Source__c}
)</expression>
    </formulas>
    <formulas>
        <description>Used to set value if blank</description>
        <name>UserSourceRoleFormula</name>
        <dataType>String</dataType>
        <expression>IF(
       ISBLANK({!Get_Contact.sM_User_Source_Role__c}),
       TEXT({!$User.scaleMatters__Current_Role__c}),
IF(
{!Get_Contact.sM_User_Source_Role__c} = &quot;Closer&quot;,
&quot;AE&quot;, 
{!Get_Contact.sM_User_Source_Role__c}
)
)</expression>
    </formulas>
