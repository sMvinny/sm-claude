    <formulas>
        <description>Formula to get sM_Meeting_Source__r.Id</description>
        <name>MeetingSourceName</name>
        <dataType>String</dataType>
        <expression>IF(
      NOT(ISBLANK({!Get_Lead.sM_Meeting_Source__c})),
{!Get_Lead.sM_Meeting_Source__r.Id} , NULL)</expression>
    </formulas>
    <formulas>
        <description>Formula to count reworks</description>
        <name>NumberOfReworks</name>
        <dataType>Number</dataType>
        <expression>IF(
        NOT(
                   ISBLANK({!Get_Lead.sM_Number_of_Reworks__c})) ,  {!Get_Lead.sM_Number_of_Reworks__c} + 1,
        1 )</expression>
