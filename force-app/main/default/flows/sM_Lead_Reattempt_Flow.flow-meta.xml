    <decisions>
        <description>Decision to tell if this is the first rework or multiple.</description>
        <name>Decision_Attempt_to_Rework</name>
        <label>Decision - Attempt to Rework</label>
        <locationX>429</locationX>
        <locationY>265</locationY>
        <defaultConnectorLabel>False</defaultConnectorLabel>
        <rules>
            <name>TRUE_First_Rework</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.sM_Attempt_to_Rework__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.sM_Number_of_Reworks__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.sM_Number_of_Reworks__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_First_Rework_Fields</targetReference>
            </connector>
            <label>TRUE First Rework</label>
        </rules>
        <rules>
            <name>TRUE_Mutliple_Rework</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Lead.sM_Attempt_to_Rework__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Lead.sM_Number_of_Reworks__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Multiple_Rework_Fields</targetReference>
            </connector>
            <label>TRUE Mutliple Rework</label>
        </rules>
    </decisions>
    <decisions>
