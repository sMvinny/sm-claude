    <recordLookups>
        <description>Used to capture details from the opportunity that launched this flow.</description>
        <name>Get_Opportunity_Record</name>
        <label>Get Opportunity Record</label>
        <locationX>219</locationX>
        <locationY>50</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Bundle_Screen</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <object>Opportunity</object>
        <outputReference>varOpp</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Pricebook2Id</queriedFields>
        <queriedFields>CloseDate</queriedFields>
        <queriedFields>sM_Discount__c</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>Used to get the opportunity product record</description>
        <name>Get_Record</name>
        <label>Get Record</label>
        <locationX>543</locationX>
        <locationY>212</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Subscription_Product</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>varOpp.Id</elementReference>
            </value>
        </filters>
        <object>OpportunityLineItem</object>
        <outputReference>CurrentProdRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Quantity</queriedFields>
        <queriedFields>UnitPrice</queriedFields>
        <queriedFields>PricebookEntryId</queriedFields>
        <queriedFields>Discount</queriedFields>
        <queriedFields>ServiceDate</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>TotalPrice</queriedFields>
    </recordLookups>
