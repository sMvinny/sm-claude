        <name>Service_Product</name>
        <label>Service Product</label>
        <locationX>822</locationX>
        <locationY>212</locationY>
        <connector>
            <targetReference>Training_Product</targetReference>
        </connector>
        <inputAssignments>
            <field>Discount</field>
            <value>
                <elementReference>CalculateDiscount</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OpportunityId</field>
            <value>
                <elementReference>varOpp.Id</elementReference>
