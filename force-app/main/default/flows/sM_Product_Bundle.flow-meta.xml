<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <description>When selecting Yes all product bundles will be added.</description>
        <name>Add_Bundle</name>
        <label>Add Bundle</label>
        <locationX>363</locationX>
        <locationY>214</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Product_Bundle</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Yes</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Record</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>This is a skeleton flow to use as a Lightning Action on the Opportunity to leverage for product bundling.</description>
    <dynamicChoiceSets>
        <name>Discount</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>sM_Discount__c</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <description>Used to select yes or no if you want to add a product bundle</description>
        <name>ProductBundle</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Product_Bundling__c</picklistField>
        <picklistObject>Opportunity</picklistObject>
    </dynamicChoiceSets>
    <formulas>
        <name>CalculateDiscount</name>
        <dataType>Number</dataType>
        <expression>IF({!DiscountPercentage} = &quot;None&quot;, 0, 
IF({!DiscountPercentage} = &quot;10%&quot;, 10, 
IF({!DiscountPercentage} = &quot;25%&quot;, 25,
IF({!DiscountPercentage} = &quot;50%&quot;, 50, 
IF({!DiscountPercentage} = &quot;75%&quot;, 75, null
)))))</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>sM - Product Bundle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sM - Product Bundle</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
