<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Hours</name>
        <label>Add Hours</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varHoursLogged</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_through_Time_Entries.Total_Case_Hours__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_through_Time_Entries</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Copy_2_of_Store_Monthly_Allotment_Default</name>
        <label>Store Monthly Allotment Default</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMonthlyAllotment</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Time_Entry_This_Month</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_Monthly_Allotment</name>
        <label>Store Monthly Allotment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMonthlyAllotment</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Get_This_Month_s_Hour_Allotment.Hours_Allotted__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Time_Entry_This_Month</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_Monthly_Allotment_From_Record</name>
        <label>Store Monthly Allotment From Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varMonthlyAllotment</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.HoursAllocatedThisMonth__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Get_Time_Entry_This_Month</targetReference>
        </connector>
    </assignments>
    <assignments>
        <name>Store_Time_Entry_Default</name>
        <label>Store Time Entry Default</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varHoursLogged</assignToReference>
            <operator>Assign</operator>
            <value>
                <numberValue>0.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Do_we_update_Account</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Do_we_update_Account</name>
        <label>Do we update Account?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Update_Account</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>varHoursLogged</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.HoursConsumedThisMonth__c</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>varMonthlyAllotment</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.HoursAllocatedThisMonth__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Account</targetReference>
            </connector>
            <label>Yes Update Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Was_This_Month_Hour_Allotment_Found</name>
        <label>Was This Month Hour Allotment Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Store_Monthly_Allotment_From_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Get Time Entries</defaultConnectorLabel>
        <rules>
            <name>Found_Hour_Allotment</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_This_Month_s_Hour_Allotment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_This_Month_s_Hour_Allotment.Hours_Allotted__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.HoursAllocatedThisMonth__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Store_Monthly_Allotment</targetReference>
            </connector>
            <label>Found Hour Allotment</label>
        </rules>
        <rules>
            <name>Hours_Not_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_This_Month_s_Hour_Allotment.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_2_of_Store_Monthly_Allotment_Default</targetReference>
            </connector>
            <label>Hours Not Found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Were_Time_Entries_found</name>
        <label>Were Time Entries found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Store_Time_Entry_Default</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Update Account</defaultConnectorLabel>
        <rules>
            <name>Found_Time_Entries</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Time_Entry_This_Month</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Loop_through_Time_Entries</targetReference>
            </connector>
            <label>Found Time Entries</label>
        </rules>
    </decisions>
    <description>Schedule to run and populate the This Month&apos;s Allotted Hours and Used Hours for customer accounts</description>
    <environments>Default</environments>
    <interviewLabel>sMI - {!$Flow.CurrentDateTime}</interviewLabel>
    <label>sMI - Daily This Month Hour Allotment &amp; Hours Logged on Account</label>
    <loops>
        <name>Loop_through_Time_Entries</name>
        <label>Loop through Time Entries</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Time_Entry_This_Month</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Hours</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Do_we_update_Account</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_This_Month_s_Hour_Allotment</name>
        <label>Get This Month&apos;s Hour Allotment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_This_Month_Hour_Allotment_Found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Display__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>This Month</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Hours_Allotment__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Account__c</queriedFields>
        <queriedFields>Display__c</queriedFields>
        <queriedFields>Hours_Allotted__c</queriedFields>
        <sortField>Display__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Time_Entry_This_Month</name>
        <label>Get Time Entry This Month</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Were_Time_Entries_found</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Account__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>Display__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>This Month</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Time_Entries__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Account__c</queriedFields>
        <queriedFields>Display__c</queriedFields>
        <queriedFields>Total_Case_Hours__c</queriedFields>
        <sortField>Display__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Account</name>
        <label>Update Account</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>HoursAllocatedThisMonth__c</field>
            <value>
                <elementReference>varMonthlyAllotment</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>HoursConsumedThisMonth__c</field>
            <value>
                <elementReference>varHoursLogged</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_This_Month_s_Hour_Allotment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Customer</stringValue>
            </value>
        </filters>
        <object>Account</object>
        <schedule>
            <dayOfMonthToRun>0</dayOfMonthToRun>
            <frequency>Daily</frequency>
            <frequencyNumber>0</frequencyNumber>
            <startDate>2026-02-26</startDate>
            <startTime>18:55:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varHoursLogged</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varMonthlyAllotment</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
