<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CompletionPercent__c</fullName>
    <description>Used to provide percentage of complete Work Items</description>
    <formula>IF(
  AllWorksItemsCount__c = 0,
  0,
  ClosedWorksItemsCount__c / AllWorksItemsCount__c
)</formula>
    <label>Completion Percent</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
