<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>IsOverdue__c</fullName>
    <description>Flags overdue tasks for reporting and escalation.</description>
    <formula>AND(
  IsClosed__c = FALSE,
  DueDate__c  &lt; TODAY()
)</formula>
    <label>Is Overdue</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
