    <description>Pulls QuickBooks invoices (read-only). Phase 1 fetches every page into memory (no saving, so callouts are never blocked); phase 2 creates new records in one batch and updates existing ones by QuickBooks ID (max 100 updates per run, then logs Partial). Flags records no longer in QuickBooks as deleted (only after a complete pull). Never touches Accounts.</description>
    <environments>Default</environments>
    <formulas><name>queryText</name><dataType>String</dataType><expression>"select * from Invoice order by Id startposition " &amp; TEXT({!startPosition}) &amp; " maxresults " &amp; TEXT({!pageSize})</expression></formulas>
    <formulas><name>txnDateValue</name><dataType>Date</dataType><expression>DATEVALUE({!Loop_Records.TxnDate})</expression></formulas>
    <formulas><name>dueDateValue</name><dataType>Date</dataType><expression>DATEVALUE(IF(ISBLANK({!Loop_Records.DueDate}), {!Loop_Records.TxnDate}, {!Loop_Records.DueDate}))</expression></formulas>
    <formulas><name>voidedValue</name><dataType>Boolean</dataType><expression>IF(ISBLANK({!Loop_Records.PrivateNote}), false, CONTAINS({!Loop_Records.PrivateNote}, "Voided"))</expression></formulas>
    <formulas><name>effectiveRealmId</name><dataType>String</dataType><expression>IF(ISBLANK({!realmId}), {!Get_Setting.Realm_Id__c}, {!realmId})</expression></formulas>
    <formulas><name>finalStatus</name><dataType>String</dataType><expression>IF({!partial}, "Partial", "Success")</expression></formulas>
