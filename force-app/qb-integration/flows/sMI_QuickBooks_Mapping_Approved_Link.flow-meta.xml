<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>After-save: when a customer mapping becomes Approved with an Account, link that customer's existing invoices and payments that have no Account. Does not edit Account records.</description>
    <environments>Default</environments>
    <label>sMI QuickBooks Mapping Approved Link</label>
    <processMetadataValues><name>BuilderType</name><value><stringValue>LightningFlowBuilder</stringValue></value></processMetadataValues>
    <processMetadataValues><name>CanvasMode</name><value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value></processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates><name>Link_Invoices</name><label>Link Invoices</label><locationX>176</locationX><locationY>100</locationY><connector><targetReference>Link_Payments</targetReference></connector><filterLogic>and</filterLogic><filters><field>QuickBooks_Customer_ID__c</field><operator>EqualTo</operator><value><elementReference>$Record.QuickBooks_Customer_ID__c</elementReference></value></filters><filters><field>Account__c</field><operator>IsNull</operator><value><booleanValue>true</booleanValue></value></filters><inputAssignments><field>Account__c</field><value><elementReference>$Record.Account__c</elementReference></value></inputAssignments><object>QuickBooks_Invoice__c</object></recordUpdates>
    <recordUpdates><name>Link_Payments</name><label>Link Payments</label><locationX>176</locationX><locationY>200</locationY><connector><targetReference>Update_Account_Customer_Id</targetReference></connector><filterLogic>and</filterLogic><filters><field>QuickBooks_Customer_ID__c</field><operator>EqualTo</operator><value><elementReference>$Record.QuickBooks_Customer_ID__c</elementReference></value></filters><filters><field>Account__c</field><operator>IsNull</operator><value><booleanValue>true</booleanValue></value></filters><inputAssignments><field>Account__c</field><value><elementReference>$Record.Account__c</elementReference></value></inputAssignments><object>QuickBooks_Payment__c</object></recordUpdates>
    <recordUpdates><name>Update_Account_Customer_Id</name><label>Set Account QB Customer ID</label><locationX>176</locationX><locationY>500</locationY><filterLogic>and</filterLogic><filters><field>Id</field><operator>EqualTo</operator><value><elementReference>$Record.Account__c</elementReference></value></filters><filters><field>QB_Customer_ID__c</field><operator>IsNull</operator><value><booleanValue>true</booleanValue></value></filters><inputAssignments><field>QB_Customer_ID__c</field><value><elementReference>$Record.QuickBooks_Customer_ID__c</elementReference></value></inputAssignments><object>Account</object></recordUpdates>
    <triggerOrder>1000</triggerOrder>
    <start><locationX>50</locationX><locationY>0</locationY><connector><targetReference>Link_Invoices</targetReference></connector><doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria><filterLogic>and</filterLogic><filters><field>Status__c</field><operator>EqualTo</operator><value><stringValue>Approved</stringValue></value></filters><filters><field>Account__c</field><operator>IsNull</operator><value><booleanValue>false</booleanValue></value></filters><object>QuickBooks_Customer_Mapping__c</object><recordTriggerType>CreateAndUpdate</recordTriggerType><triggerType>RecordAfterSave</triggerType></start>
    <status>Active</status>
</Flow>
