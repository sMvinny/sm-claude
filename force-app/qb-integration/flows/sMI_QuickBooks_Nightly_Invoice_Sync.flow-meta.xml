<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Nightly schedule for the QuickBooks Invoice Sync. Scheduled flows cannot call QuickBooks, so this only creates a Sync Request; sMI QuickBooks Sync Request Run does the callout asynchronously.</description>
    <environments>Default</environments>
    <label>sMI QuickBooks Nightly Invoice Sync</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value><stringValue>AUTO_LAYOUT_CANVAS</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Invoice_Request</name>
        <label>Create Invoice Request</label>
        <locationX>176</locationX>
        <locationY>100</locationY>
        <inputAssignments>
            <field>Sync_Type__c</field>
            <value><stringValue>Invoice</stringValue></value>
        </inputAssignments>
        <object>QuickBooks_Sync_Request__c</object>
    </recordCreates>
    <runInMode>SystemModeWithoutSharing</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector><targetReference>Create_Invoice_Request</targetReference></connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-11-12</startDate>
            <startTime>03:20:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
